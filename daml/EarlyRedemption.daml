module EarlyRedemption where

import Daml.Finance.Interface.Asset.Base qualified as Asset (I, SetCid(..))
import Bond qualified
import DA.Date (Date, addDays, toDateUTC)
import DA.Time (getTime)
import DA.Assert (assertMsg)

-- | Defines the terms for optional early redemption (callability) of a bond.
-- This record is embedded within the main Bond.Data payload.
data Terms = Terms
  with
    callable : Bool
      -- ^ Whether the bond is callable by the issuer for early redemption.
    callStartDate : Optional Date
      -- ^ The date from which the bond can be called. If None, it can be called anytime after issuance.
    callPremiumRate : Decimal
      -- ^ The premium rate paid on top of the face value upon early redemption. E.g., 0.01 for 1%.
      -- A rate of 0.0 means the bond is redeemable at par.
    noticePeriodDays : Int
      -- ^ The minimum number of days notice the issuer must give to investors before the redemption date.
  deriving (Eq, Show)

-- | Proposal from an issuer to an investor to redeem a bond holding early.
-- This contract is created by the issuer and must be accepted by the investor
-- to proceed with the redemption.
template Proposal
  with
    issuer : Party
      -- ^ The party initiating the redemption, i.e., the bond issuer.
    investor : Party
      -- ^ The bondholder whose holding is being redeemed.
    bondAssetCid : Asset.I
      -- ^ The specific bond asset contract to be redeemed. This represents the investor's holding.
    bondData : Bond.Data
      -- ^ The underlying parameters of the bond series.
    redemptionDate : Date
      -- ^ The proposed date for the early redemption.
    redemptionAmount : Decimal
      -- ^ The total amount to be paid to the investor (face value + call premium).
    callPremium : Decimal
      -- ^ The calculated call premium amount.
    observers : [Party]
      -- ^ Additional observers from the original bond contract.
  where
    signatory issuer
    observer investor, observers

    key (issuer, investor, bondData.id) : (Party, Party, Text)
    maintainer key._1

    choice Accept : ContractId Bond.RedeemedEvent
      -- ^ The investor accepts the early redemption proposal.
      -- This triggers the redemption process on the underlying bond asset, resulting in a `RedeemedEvent`.
      controller investor
      do
        exercise bondAssetCid Bond.RedeemEarly with redemptionAmount, redemptionDate

    choice Withdraw : ()
      -- ^ The issuer withdraws the redemption proposal before it's accepted.
      controller issuer
      do
        -- No further action needed, archiving self is sufficient.
        pure ()

-- | Helper function intended to be called from a choice on the bond instrument (e.g., Bond.Instrument).
-- It validates the proposal against the bond's terms and the current time, then creates the
-- `EarlyRedemption.Proposal` contract.
createRedemptionProposal :
  Party -> Asset.I -> Bond.Data -> Date -> Update (ContractId Proposal)
createRedemptionProposal controllerCid bondAssetCid bondData redemptionDate = do
  -- The controller of the originating choice must be the issuer.
  assertMsg "Only the bond issuer can propose an early redemption." (controllerCid == bondData.issuer)

  -- Fetch the bond asset to identify the investor (owner).
  (_assetCid, asset) <- fetchAncillary @Asset.SetCid bondAssetCid
  let investor = asset.owner

  -- Ensure early redemption terms are present and the bond is callable.
  terms <- case bondData.earlyRedemptionTerms of
    Some t -> pure t
    None -> abort "Bond is not callable for early redemption."
  assertMsg "Early redemption terms specify this bond is not callable." terms.callable

  -- Get current ledger time for validation.
  now <- toDateUTC <$> getTime

  -- Validate that the call is not happening before the allowed start date.
  case terms.callStartDate of
    Some startDate ->
      assertMsg ("Bond cannot be called before " <> show startDate) (now >= startDate)
    None -> pure ()

  -- Validate that the redemption date respects the required notice period.
  let earliestRedemptionDate = addDays terms.noticePeriodDays now
  assertMsg
    ("Proposed redemption date of " <> show redemptionDate <>
     " does not respect the required notice period of " <> show terms.noticePeriodDays <> " days. " <>
     "Earliest possible redemption date is " <> show earliestRedemptionDate <> ".")
    (redemptionDate >= earliestRedemptionDate)

  -- Calculate premium and total redemption amount.
  let callPremium = bondData.faceValue * terms.callPremiumRate
  let redemptionAmount = bondData.faceValue + callPremium

  -- Create the proposal contract.
  create Proposal with
    issuer = bondData.issuer
    investor
    bondAssetCid
    bondData
    redemptionDate
    redemptionAmount
    callPremium
    observers = bondData.observers