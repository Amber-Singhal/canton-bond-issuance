module EarlyRedemptionTest where

import Daml.Script
import DA.Date
import DA.Date.Types (Month(..))
import DA.Time (time)

import EarlyRedemption
import Bond (Bond(..)) -- Assuming a core Bond template exists in Bond.daml

earlyRedemptionTests : Script ()
earlyRedemptionTests = script do
  -- === Setup parties and time ===
  let now = time (date 2024 Jan 01) 0 0 0
  setTime now

  issuer <- allocatePartyWithHint "Issuer" (PartyIdHint "issuer")
  investor <- allocatePartyWithHint "Investor" (PartyIdHint "investor")
  agent <- allocatePartyWithHint "PayingAgent" (PartyIdHint "paying-agent")
  regulator <- allocatePartyWithHint "Regulator" (PartyIdHint "regulator")

  -- === Bond parameters ===
  let
    issueDate = date 2024 Jan 15
    maturityDate = date 2029 Jan 15
    firstCallDate = date 2026 Jan 15
    secondCallDate = date 2027 Jan 15

    bond = Bond
      with
        issuer
        investor
        agent
        observers = [regulator]
        isin = "CH0123456789"
        currency = "USD"
        principal = 1_000_000.0
        couponRate = 0.05
        issueDate
        maturityDate
        lastCouponDate = issueDate
        couponPeriodMonths = 6
        dayCountConvention = "ACT/365"

    callSchedule =
      [ CallDate with date = firstCallDate, price = 1.02 -- Callable at 102% of principal
      , CallDate with date = secondCallDate, price = 1.01 -- Callable at 101% of principal
      ]

  -- === Helper to create a clean slate for each test ===
  let setupTest = do
        bondCid <- submit issuer do
          createCmd bond
        rightCid <- submit issuer do
          createCmd EarlyRedemptionRight with issuer, investor, bond, bondCid, callSchedule
        return (bondCid, rightCid)

  -- === Test Scenarios ===

  test "Successful early redemption on first call date" do
    (bondCid, rightCid) <- setupTest

    -- Set time to the first call date
    let redemptionTime = time firstCallDate 0 0 0
    setTime redemptionTime

    -- Issuer exercises the redemption right
    settlementCid <- submit issuer do
      exerciseCmd rightCid ExerciseEarlyRedemption with callDate = firstCallDate

    -- Verify the settlement instruction
    settlement <- fetch settlementCid
    let
      -- Accrued interest calculation for 2 years (2024-01-15 to 2026-01-15)
      -- Note: In a real scenario, this would depend on the last coupon payment.
      -- Here we simplify assuming interest accrues from the issue date.
      daysAccrued = daysInDateRange issueDate firstCallDate
      expectedInterest = bond.principal * bond.couponRate * (intToDecimal daysAccrued / 365.0)
      expectedRedemptionPrice = bond.principal * 1.02 -- From call schedule
      expectedAmount = expectedRedemptionPrice + expectedInterest

    settlement.payer === issuer
    settlement.receiver === investor
    settlement.settlementDate === firstCallDate
    settlement.amount === expectedAmount
    settlement.currency === bond.currency
    settlement.bondCid === bondCid

    -- Verify the redemption right contract is consumed
    query @EarlyRedemptionRight issuer >>= \rights ->
      assert (null rights)


  test "Unauthorized party cannot exercise redemption right" do
    (_bondCid, rightCid) <- setupTest

    -- Set time to a valid call date
    let redemptionTime = time firstCallDate 0 0 0
    setTime redemptionTime

    -- Investor tries to exercise the right, which should fail
    submitMustFail investor do
      exerciseCmd rightCid ExerciseEarlyRedemption with callDate = firstCallDate


  test "Redemption fails if attempted before call date" do
    (_bondCid, rightCid) <- setupTest

    -- Set time to one day before the first call date
    let earlyAttemptDate = addDays firstCallDate (-1)
    let earlyAttemptTime = time earlyAttemptDate 0 0 0
    setTime earlyAttemptTime

    -- Issuer tries to exercise the right early, which should fail
    submitMustFail issuer do
      exerciseCmd rightCid ExerciseEarlyRedemption with callDate = firstCallDate


  test "Redemption fails for a date not in the call schedule" do
    (_bondCid, rightCid) <- setupTest
    let invalidCallDate = addDays firstCallDate 1
    let attemptTime = time firstCallDate 0 0 0 -- The current time is valid
    setTime attemptTime

    -- Issuer tries to exercise for a date that isn't on the schedule
    submitMustFail issuer do
      exerciseCmd rightCid ExerciseEarlyRedemption with callDate = invalidCallDate


  test "Successful early redemption on second call date" do
    (bondCid, rightCid) <- setupTest

    -- Set time to the second call date
    let redemptionTime = time secondCallDate 0 0 0
    setTime redemptionTime

    -- Issuer exercises the redemption right
    settlementCid <- submit issuer do
      exerciseCmd rightCid ExerciseEarlyRedemption with callDate = secondCallDate

    -- Verify the settlement instruction
    settlement <- fetch settlementCid
    let
      daysAccrued = daysInDateRange issueDate secondCallDate
      expectedInterest = bond.principal * bond.couponRate * (intToDecimal daysAccrued / 365.0)
      expectedRedemptionPrice = bond.principal * 1.01 -- Price for the second call date
      expectedAmount = expectedRedemptionPrice + expectedInterest

    settlement.payer === issuer
    settlement.receiver === investor
    settlement.settlementDate === secondCallDate
    settlement.amount === expectedAmount
    settlement.bondCid === bondCid


  test "Settlement instruction can be accepted by the investor" do
    (_bondCid, rightCid) <- setupTest
    let redemptionTime = time firstCallDate 0 0 0
    setTime redemptionTime

    settlementCid <- submit issuer do
      exerciseCmd rightCid ExerciseEarlyRedemption with callDate = firstCallDate

    -- Investor accepts the settlement instruction
    settlementConfirmationCid <- submit investor do
      exerciseCmd settlementCid AcceptSettlement

    -- Verify confirmation details
    confirmation <- fetch settlementConfirmationCid
    confirmation.payer === issuer
    confirmation.receiver === investor
    confirmation.settlementDate === firstCallDate

    -- Verify the settlement instruction is consumed
    query @EarlyRedemptionSettlementInstruction investor >>= \instructions ->
      assert (null instructions)


  test "Redemption fails if bond has already been redeemed" do
    (bondCid, rightCid) <- setupTest
    let redemptionTime = time firstCallDate 0 0 0
    setTime redemptionTime

    -- First, successfully exercise the redemption
    settlementCid <- submit issuer do
      exerciseCmd rightCid ExerciseEarlyRedemption with callDate = firstCallDate

    -- At this point, `rightCid` is archived. Any attempt to use it again will fail.
    -- This tests that the contract was correctly consumed.
    submitMustFail issuer do
      exerciseCmd rightCid ExerciseEarlyRedemption with callDate = firstCallDate