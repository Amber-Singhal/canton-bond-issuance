module Redemption where

import Daml.Script
import DA.Date
import DA.Time
import DA.Assert
import Bond (Bond(..))

-- | A request from a bond holder to the paying agent to redeem their bond holding at maturity.
-- | This is typically created by the investor on or after the bond's maturity date.
template RedemptionRequest
  with
    issuer : Party
      -- ^ The original issuer of the bond.
    investor : Party
      -- ^ The current owner of the bond requesting redemption.
    payingAgent : Party
      -- ^ The party responsible for processing the redemption payment.
    bondCid : ContractId Bond
      -- ^ The contract ID of the bond to be redeemed.
    bondIsin : Text
      -- ^ The ISIN identifier of the bond.
    faceValue : Decimal
      -- ^ The principal amount to be returned at maturity.
    currency : Text
      -- ^ The currency of the face value.
    maturityDate : Date
      -- ^ The maturity date of the bond.
  where
    signatory investor
    observer payingAgent

    key (investor, bondIsin) : (Party, Text)
    maintainer key._1

    -- | The paying agent confirms and processes the redemption.
    -- | In a real-world scenario, this choice would be part of a larger Delivery-vs-Payment (DvP)
    -- | workflow, where the bond asset is atomically swapped for a cash-equivalent token.
    -- | For simplicity, this choice creates a confirmation record, assuming payment is handled
    -- | by an external process or a separate DvP contract.
    choice ProcessRedemption : ContractId RedemptionConfirmation
      with
        -- | The effective date of the redemption payment.
        redemptionDate : Date
      controller payingAgent
      do
        -- Fetch the bond contract to verify its current state
        bond <- fetch bondCid

        -- Ensure the redemption is happening at or after maturity by checking ledger time
        now <- getTime
        assertMsg "Cannot process redemption before the bond's maturity date." (toDateUTC now >= maturityDate)

        -- Validate the provided redemption date
        assertMsg "Redemption date cannot be before the bond's maturity date." (redemptionDate >= maturityDate)

        -- Verify the controller is the correct paying agent for this bond
        assertMsg "Controller is not the designated paying agent for this bond." (payingAgent == bond.payingAgent)

        -- Verify the investor on the request is the current owner of the bond
        assertMsg "The requesting party is not the current owner of the bond." (investor == bond.owner)

        -- Create a confirmation record of the redemption
        confirmationCid <- create RedemptionConfirmation with
          issuer = issuer
          investor = investor
          payingAgent = payingAgent
          bondIsin = bondIsin
          redemptionAmount = faceValue
          currency = currency
          redemptionDate = redemptionDate

        -- The request is consumed upon processing. The Bond contract itself is not archived here;
        -- it would typically be archived as the 'delivery' leg in a DvP settlement.
        archive self

        return confirmationCid

-- | An immutable record confirming that a bond's principal (face value) has been returned
-- | to the investor upon maturity. This serves as a verifiable receipt for all parties.
template RedemptionConfirmation
  with
    issuer : Party
      -- ^ The original issuer of the bond.
    investor : Party
      -- ^ The investor who received the redemption payment.
    payingAgent : Party
      -- ^ The agent who processed the payment.
    bondIsin : Text
      -- ^ The ISIN of the redeemed bond.
    redemptionAmount : Decimal
      -- ^ The principal amount returned.
    currency : Text
      -- ^ The currency of the payment.
    redemptionDate : Date
      -- ^ The date the redemption was processed.
  where
    signatory payingAgent, investor
    observer issuer

    key (investor, bondIsin) : (Party, Text)
    maintainer key._1