module Bond where

import Daml.Script
import DA.Date
import DA.Time
import DA.Map (Map)
import qualified DA.Map as M
import DA.Validation

-- Data type for coupon payment frequency
data CouponFrequency = Annually | SemiAnnually | Quarterly | Monthly
  deriving (Eq, Show, Ord, Bounded, Enum)

-- Calculates the number of months between coupon payments based on frequency.
monthsPerCoupon : CouponFrequency -> Int
monthsPerCoupon Annually = 12
monthsPerCoupon SemiAnnually = 6
monthsPerCoupon Quarterly = 3
monthsPerCoupon Monthly = 1

-- Represents the obligation to repay the principal amount to an investor at maturity.
-- This contract is created when the main `Bond` contract is redeemed.
template RedemptionObligation
  with
    issuer        : Party
    investor      : Party
    payingAgent   : Party
    isin          : Text
    currency      : Text
    principalAmount : Decimal
  where
    signatory issuer
    observer investor, payingAgent

    key (issuer, investor, isin) : (Party, Party, Text)
    maintainer key._1

    -- The paying agent confirms that the principal has been repaid, settling the obligation.
    choice Settle : ()
      controller payingAgent
      do
        return ()

-- The core bond contract representing the terms and ownership of the issuance.
-- This contract lives from issuance until maturity.
template Bond
  with
    issuer        : Party          -- The entity that issued the bond.
    isin          : Text           -- International Securities Identification Number.
    description   : Text           -- A description of the bond (e.g., "5Y Corporate Bond").
    currency      : Text           -- The currency of the bond (e.g., "USD").
    faceValue     : Decimal        -- The nominal value of a single bond unit.
    couponRate    : Decimal        -- The annual interest rate (e.g., 0.05 for 5%).
    couponFrequency : CouponFrequency -- How often coupons are paid.
    issuanceDate  : Date           -- The date the bond was issued.
    maturityDate  : Date           -- The date the principal is to be repaid.
    payingAgent   : Party          -- The party responsible for payments.
    investors     : Map Party Decimal -- A map from investor party to their total holding (face value).
    totalSupply   : Decimal        -- The total face value of the entire bond issue.
    lastCouponDate: Date           -- The date of the last coupon payment, initialized to issuanceDate.
    observers     : [Party]        -- Additional observers, e.g., regulators.
  where
    signatory issuer, payingAgent
    observer M.keys investors ++ observers

    ensure
      let
        validation = do
          V.assert (faceValue > 0.0) "Face value must be positive."
          V.assert (couponRate >= 0.0) "Coupon rate must be non-negative."
          V.assert (maturityDate > issuanceDate) "Maturity date must be after issuance date."
          V.assert (lastCouponDate >= issuanceDate && lastCouponDate <= maturityDate) "Last coupon date must be between issuance and maturity."
          V.assert (totalSupply == sum (M.values investors)) "Sum of investor holdings must equal total supply."
          V.assert (M.all (> 0.0) investors) "All investor holdings must be positive."
      in case evalValidation validation of
        V.Success _ -> ()
        V.Error e -> abort e

    key (issuer, isin) : (Party, Text)
    maintainer key._1

    -- Calculates the next scheduled coupon payment date.
    nonconsuming choice GetNextCouponDate : Optional Date
      controller M.keys investors ++ [issuer, payingAgent]
      do
        let nextDate = addMonths (monthsPerCoupon couponFrequency) lastCouponDate
        if nextDate > maturityDate then return None else return (Some nextDate)

    -- An investor transfers a portion of their bond holding to another party.
    choice Transfer : ContractId Bond
      with
        fromInvestor   : Party
        toInvestor     : Party
        transferAmount : Decimal
      controller fromInvestor
      do
        assertMsg "Cannot transfer to self." (fromInvestor /= toInvestor)
        assertMsg "Transfer amount must be positive." (transferAmount > 0.0)

        -- Validate that the sender holds enough to transfer
        let fromHolding = fromMaybe 0.0 (M.lookup fromInvestor investors)
        assertMsg "Insufficient holding for transfer." (fromHolding >= transferAmount)

        -- Calculate new holdings
        let newFromHolding = fromHolding - transferAmount
        let toHolding = fromMaybe 0.0 (M.lookup toInvestor investors)
        let newToHolding = toHolding + transferAmount

        -- Atomically update the investors map
        let investorsAfterTo = M.insert toInvestor newToHolding investors
        let updatedInvestors =
              if newFromHolding > 0.0
              then M.insert fromInvestor newFromHolding investorsAfterTo
              else M.delete fromInvestor investorsAfterTo

        create this with investors = updatedInvestors

    -- The paying agent records a coupon distribution event, advancing the state of the bond.
    -- In a full implementation, this choice would be coupled with a cash transfer mechanism.
    choice RecordCouponDistribution : ContractId Bond
      with
        paymentDate : Date
      controller payingAgent
      do
        nextDateOpt <- exercise self GetNextCouponDate
        case nextDateOpt of
          None -> abort "No more coupon payments are scheduled."
          Some expectedNextCouponDate -> do
            assertMsg ("Invalid coupon payment date. Expected: " <> show expectedNextCouponDate) (paymentDate == expectedNextCouponDate)
            create this with lastCouponDate = paymentDate

    -- At maturity, the paying agent triggers the redemption process.
    -- This archives the bond and creates principal repayment obligations for each investor.
    choice RedeemAtMaturity : [ContractId RedemptionObligation]
      with
        currentTime : Time
      controller payingAgent
      do
        assertMsg "Bond has not yet matured." (toDateUTC currentTime >= maturityDate)

        -- Create a redemption obligation for each investor
        obligations <- forA (M.toList investors) \(investor, holding) ->
          create RedemptionObligation with
            issuer = issuer
            investor = investor
            payingAgent = payingAgent
            isin = isin
            currency = currency
            principalAmount = holding

        -- Archive the matured bond contract, as its lifecycle is complete.
        archive self

        return obligations