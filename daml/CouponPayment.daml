-- |
-- Module:      CouponPayment
-- Description: Daml templates and logic for bond coupon payments.
--
-- This module contains the `CouponPaymentObligation` template, representing
-- the obligation of a paying agent to pay a bond coupon to a holder.
-- It also includes helper functions for calculating coupon amounts based on
-- the 'Actual/Actual' day count convention, correctly handling leap years.

module CouponPayment where

import DA.Assert
import DA.Date
import DA.Time
import Daml.Script

-- | Represents an obligation for a paying agent to deliver a coupon payment
-- to a bond holder on a specified date. This contract is typically created
-- ahead of the payment date based on the bond's terms.
template CouponPaymentObligation
  with
    payingAgent : Party
      -- ^ The party responsible for making the payment.
    bondHolder : Party
      -- ^ The party entitled to receive the coupon payment.
    isin: Text
      -- ^ International Securities Identification Number of the bond.
    couponPeriodStartDate: Date
      -- ^ The start date of the interest accrual period for this coupon.
    paymentDate : Date
      -- ^ The date on which the coupon payment is due.
    couponAmount : Decimal
      -- ^ The calculated amount of the coupon payment.
    currency: Text
      -- ^ The currency of the payment (e.g., "USD").
  where
    signatory payingAgent
    observer bondHolder

    ensure paymentDate >= couponPeriodStartDate

    key (payingAgent, bondHolder, isin, paymentDate) : (Party, Party, Text, Date)
    maintainer key._1

    -- | Choice exercised by the paying agent to settle the coupon payment.
    -- In a real-world scenario, this would be part of a larger Delivery-vs-Payment
    -- workflow, atomically exchanging the coupon obligation for a cash payment.
    -- For simplicity, this choice just archives the obligation.
    choice Settle : ()
      controller payingAgent
      do
        -- In a production system, this would trigger a payment leg.
        -- For example: `exercise cashCid Transfer with newOwner = bondHolder`.
        -- Here, we simply archive the obligation to signify settlement.
        return ()

-- | Determines if a given year is a leap year.
-- A year is a leap year if it is divisible by 4, except for end-of-century
-- years, which must also be divisible by 400.
isLeapYear : Int -> Bool
isLeapYear year =
  (year % 4 == 0) && (year % 100 /= 0 || year % 400 == 0)

-- | Returns the number of days in a given year, accounting for leap years.
daysInYear : Int -> Int
daysInYear year =
  if isLeapYear year then 366 else 365

-- | Calculates the coupon payment amount for a given period using the
-- Actual/Actual ISDA day count convention.
-- This convention correctly handles coupon periods that span across years,
-- including leap years.
--
-- Arguments:
--   periodStartDate: The start date of the coupon accrual period.
--   periodEndDate: The end date of the coupon accrual period (typically the payment date).
--   principal: The face value of the bond holding.
--   annualCouponRate: The annual interest rate of the bond (e.g., 0.05 for 5%).
calculateActualActualCouponAmount
  : Date      -- ^ periodStartDate
  -> Date     -- ^ periodEndDate
  -> Decimal  -- ^ principal
  -> Decimal  -- ^ annualCouponRate
  -> Decimal
calculateActualActualCouponAmount periodStartDate periodEndDate principal annualCouponRate =
  let
    yearStart = year periodStartDate
    yearEnd = year periodEndDate

    yearFraction =
      if yearStart == yearEnd then
        -- The entire coupon period is within a single year.
        let
          daysInPeriod = intToDecimal $ daysBetween periodStartDate periodEndDate
          daysInCurrentYear = intToDecimal $ daysInYear yearStart
        in
          assertMsg "Denominator cannot be zero" (daysInCurrentYear > 0.0) $
          daysInPeriod / daysInCurrentYear
      else
        -- The coupon period crosses a year boundary.
        -- We must calculate the fraction of the period in the first year and the
        -- fraction in the second year separately, using their respective day counts.
        let
          yearBoundaryDate = fromGregorian yearEnd Jan 1

          -- Portion of the coupon period falling in the first year.
          daysInFirstYearPortion = intToDecimal $ daysBetween periodStartDate yearBoundaryDate
          totalDaysInFirstYear = intToDecimal $ daysInYear yearStart
          fractionInFirstYear =
            assertMsg "Denominator for first year cannot be zero" (totalDaysInFirstYear > 0.0) $
            daysInFirstYearPortion / totalDaysInFirstYear

          -- Portion of the coupon period falling in the second year.
          daysInSecondYearPortion = intToDecimal $ daysBetween yearBoundaryDate periodEndDate
          totalDaysInSecondYear = intToDecimal $ daysInYear yearEnd
          fractionInSecondYear =
            assertMsg "Denominator for second year cannot be zero" (totalDaysInSecondYear > 0.0) $
            daysInSecondYearPortion / totalDaysInSecondYear
        in
          fractionInFirstYear + fractionInSecondYear

  in
    principal * annualCouponRate * yearFraction

-- | Example usage of the calculation logic in a Daml Script.
-- This demonstrates how the coupon amount would be calculated and how an
-- obligation contract would be created.
setup: Script ()
setup = script do
  pAgent <- allocateParty "PayingAgent"
  bHolder <- allocateParty "BondHolder"

  -- Scenario 1: Coupon period within a single non-leap year (2023)
  -- 181 days in period / 365 days in year
  let
    startDate1 = fromGregorian 2023 Jan 15
    endDate1 = fromGregorian 2023 Jul 15
    principal1 = 1_000_000.0
    rate1 = 0.05 -- 5%
    amount1 = calculateActualActualCouponAmount startDate1 endDate1 principal1 rate1
  debug $ "Scenario 1 (non-leap year): " <> show amount1 -- Expected: 24794.5205479452

  -- Scenario 2: Coupon period within a single leap year (2024)
  -- 182 days in period / 366 days in year
  let
    startDate2 = fromGregorian 2024 Jan 15
    endDate2 = fromGregorian 2024 Jul 15
    principal2 = 1_000_000.0
    rate2 = 0.05 -- 5%
    amount2 = calculateActualActualCouponAmount startDate2 endDate2 principal2 rate2
  debug $ "Scenario 2 (leap year): " <> show amount2 -- Expected: 24863.3879781421

  -- Scenario 3: Coupon period crossing from a non-leap (2023) to a leap year (2024)
  -- (47 days / 365) + (135 days / 366)
  let
    startDate3 = fromGregorian 2023 Nov 15
    endDate3 = fromGregorian 2024 May 15
    principal3 = 1_000_000.0
    rate3 = 0.05 -- 5%
    amount3 = calculateActualActualCouponAmount startDate3 endDate3 principal3 rate3
  debug $ "Scenario 3 (crossing year boundary): " <> show amount3 -- Expected: 24880.9944204478

  -- Create a sample obligation contract
  _ <- submit pAgent do
    createCmd CouponPaymentObligation with
      payingAgent = pAgent
      bondHolder = bHolder
      isin = "US000TEST000"
      couponPeriodStartDate = startDate3
      paymentDate = endDate3
      couponAmount = amount3
      currency = "USD"

  return ()