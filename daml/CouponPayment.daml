module CouponPayment where

import DA.Date (Date)
import DA.Assert (assertMsg)

import Daml.Finance.Interface.Types.Common.Types (Account, Id)
import Daml.Finance.Interface.Asset.Fungible qualified as Fungible (I, exerciseInterfaceByKey, Split(..), Transfer(..))

import Bond (I, View, Holding)

-- | An instruction from the Issuer to the PayingAgent to prepare for a coupon payment.
-- The PayingAgent will acknowledge this instruction, creating a `CouponPayment` contract
-- that will manage the funding and disbursement process.
template CouponPaymentInstruction
  with
    issuer: Party
      -- ^ The party issuing the bond.
    payingAgent: Party
      -- ^ The agent responsible for disbursing coupon payments.
    bondCid: ContractId I
      -- ^ The contract ID of the bond for which the coupon is being paid.
    bondView: View
      -- ^ The view of the bond instrument at the time of instruction.
    paymentDate: Date
      -- ^ The scheduled date for this coupon payment.
    recordDate: Date
      -- ^ The date on which bond holdings are checked to determine who receives payment.
    couponAmountPerUnit: Decimal
      -- ^ The calculated coupon amount for each unit of the bond's notional quantity.
    currency: Id
      -- ^ The identifier for the payment currency.
  where
    signatory issuer
    observer payingAgent

    key (bondView.id, paymentDate) : (Id, Date)
    maintainer key._1.signatories

    ensure
      bondView.issuer == issuer &&
      bondView.payingAgent == some payingAgent &&
      recordDate < paymentDate

    choice Acknowledge : ContractId CouponPayment
      -- ^ The PayingAgent acknowledges the instruction and creates the active `CouponPayment` contract.
      with
        payingAgentAccount: Account
          -- ^ The account controlled by the paying agent where the issuer should send the funds.
      controller payingAgent
      do
        let
          requiredAmount = bondView.quantity * couponAmountPerUnit
        create CouponPayment with
          issuer
          payingAgent
          bondCid
          bondView
          paymentDate
          recordDate
          couponAmountPerUnit
          currency
          requiredAmount
          fundedAmount = 0.0
          payingAgentAccount

-- | Manages the lifecycle of a single coupon payment event.
-- It tracks the funding status from the issuer and allows the paying agent to disburse
-- funds to bondholders once fully funded.
template CouponPayment
  with
    issuer: Party
      -- ^ The party issuing the bond.
    payingAgent: Party
      -- ^ The agent responsible for disbursing coupon payments.
    bondCid: ContractId I
      -- ^ The contract ID of the bond for which the coupon is being paid.
    bondView: View
      -- ^ The view of the bond instrument.
    paymentDate: Date
      -- ^ The scheduled date for this coupon payment.
    recordDate: Date
      -- ^ The date on which bond holdings are checked to determine who receives payment.
    couponAmountPerUnit: Decimal
      -- ^ The coupon amount for each unit of the bond's notional quantity.
    currency: Id
      -- ^ The identifier for the payment currency.
    requiredAmount: Decimal
      -- ^ The total amount required to pay all bondholders.
    fundedAmount: Decimal
      -- ^ The total amount funded by the issuer so far.
    payingAgentAccount: Account
      -- ^ The account controlled by the paying agent where the issuer sends funds.
  where
    signatory payingAgent
    observer issuer

    key (bondView.id, paymentDate) : (Id, Date)
    maintainer key._1.signatories

    -- | A stakeholder can view the payment status to know if it has been funded.
    nonconsuming choice GetStatus : (Decimal, Decimal)
      controller issuer, payingAgent
      do
        return (fundedAmount, requiredAmount)

    choice Fund : ContractId CouponPayment
      -- ^ The issuer transfers funds to the paying agent for the coupon payment.
      -- This can be done in one or more tranches.
      with
        amountToFund: Decimal
        fundingCid: ContractId Fungible.I
      controller issuer
      do
        assertMsg "Funding amount must be positive" $ amountToFund > 0.0
        let newFundedAmount = fundedAmount + amountToFund
        assertMsg "Cannot fund more than the required amount" $
          newFundedAmount <= requiredAmount

        -- Transfer the funds to the paying agent's designated account
        Fungible.exerciseInterfaceByKey @Fungible.I issuer fundingCid
          (Fungible.Transfer with destination = payingAgentAccount; newObservers = [])

        create this with fundedAmount = newFundedAmount

    choice Disburse : ()
      -- ^ The paying agent disburses the coupon payments to all eligible bondholders.
      -- This choice is consuming and archives the `CouponPayment` contract upon successful disbursement.
      with
        holdingsToPay: [ContractId Holding]
          -- ^ A list of bond holding contracts as of the record date.
        fundingCid: ContractId Fungible.I
          -- ^ The fungible contract held by the paying agent containing the total payment amount.
      controller payingAgent
      do
        assertMsg "Coupon payment is not fully funded" $ fundedAmount == requiredAmount

        -- Verify the funding contract has the correct amount and is owned by the paying agent.
        fundingContract <- fetch fundingCid
        assertMsg "Incorrect funding contract provided" $
          fundingContract.instrument == currency &&
          fundingContract.account == payingAgentAccount &&
          fundingContract.amount == requiredAmount

        -- This recursive helper pattern processes the payment for each bondholder.
        let
          disburse' remainingFundingCid [] = return ()
          disburse' currentFundingCid (holdingCid :: rest) = do
            holding <- fetch holdingCid
            let paymentAmount = holding.quantity * self.couponAmountPerUnit
            if paymentAmount > 0.0 then do
              -- Split the main fungible contract to get a piece for this specific payment
              (paymentCid, nextFundingCid) <- exercise currentFundingCid Fungible.Split with splitAmount = paymentAmount

              -- Transfer the payment to the bondholder's account
              Fungible.exerciseInterfaceByKey @Fungible.I self.payingAgent paymentCid
                (Fungible.Transfer with destination = holding.ownerAccount; newObservers = [])

              -- Create a receipt for the transaction
              create CouponPaymentReceipt with
                payingAgent = self.payingAgent
                bondholder = holding.owner
                bondView = self.bondView
                paymentDate = self.paymentDate
                paidAmount = paymentAmount

              -- Recurse with the remaining fungible contract and the rest of the holdings
              disburse' nextFundingCid rest
            else
              -- If payment amount is zero, skip to the next holding
              disburse' currentFundingCid rest

        disburse' fundingCid holdingsToPay

-- | A record of a successfully disbursed coupon payment to a single bondholder.
template CouponPaymentReceipt
  with
    payingAgent: Party
      -- ^ The party that made the payment.
    bondholder: Party
      -- ^ The party that received the payment.
    bondView: View
      -- ^ A snapshot of the bond's data at the time of payment.
    paymentDate: Date
      -- ^ The date the coupon was paid.
    paidAmount: Decimal
      -- ^ The amount paid to the bondholder.
  where
    signatory payingAgent
    observer bondholder